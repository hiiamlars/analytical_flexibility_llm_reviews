}

@online{zhuWhenYourReviewer2025a,
  title = {When {{Your Reviewer}} Is an {{LLM}}: {{Biases}}, {{Divergence}}, and {{Prompt Injection Risks}} in {{Peer Review}}},
  shorttitle = {When {{Your Reviewer}} Is an {{LLM}}},
  author = {Zhu, Changjia and Xiong, Junjie and Ma, Renkai and Lu, Zhicong and Liu, Yao and Li, Lingyao},
