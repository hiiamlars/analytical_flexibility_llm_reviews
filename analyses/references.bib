  file = {C:\Users\Lars\Zotero\storage\CSR2WNKH\Schmidgall et al. - 2025 - Agent Laboratory Using LLM Agents as Research Assistants.pdf}
}

@article{schoenebeckLearningStronglyTruthful2021,
  title = {Learning and {{Strongly Truthful Multi-Task Peer Prediction}}: {{A Variational Approach}}},
  shorttitle = {Learning and {{Strongly Truthful Multi-Task Peer Prediction}}},
  author = {Schoenebeck, Grant and Yu, Fang-Yi},
  date = {2021},
  journaltitle = {LIPIcs, Volume 185, ITCS 2021},
  shortjournal = {LIPIcs Vol. 185 ITCS 2021},
  volume = {185},
  eprint = {2009.14730},
  eprinttype = {arXiv},
  eprintclass = {cs},
  pages = {78:1-78:20},
  issn = {1868-8969},
  doi = {10.4230/LIPIcs.ITCS.2021.78},
  url = {http://arxiv.org/abs/2009.14730},
  urldate = {2025-11-03},
  abstract = {Peer prediction mechanisms incentivize agents to truthfully report their signals even in the absence of verification by comparing agents' reports with those of their peers. In the detail-free multi-task setting, agents respond to multiple independent and identically distributed tasks, and the mechanism does not know the prior distribution of agents' signals. The goal is to provide an \$\textbackslash epsilon\$-strongly truthful mechanism where truth-telling rewards agents "strictly" more than any other strategy profile (with \$\textbackslash epsilon\$ additive error), and to do so while requiring as few tasks as possible. We design a family of mechanisms with a scoring function that maps a pair of reports to a score. The mechanism is strongly truthful if the scoring function is "prior ideal," and \$\textbackslash epsilon\$-strongly truthful as long as the scoring function is sufficiently close to the ideal one. This reduces the above mechanism design problem to a learning problem -- specifically learning an ideal scoring function. We leverage this reduction to obtain the following three results. 1) We show how to derive good bounds on the number of tasks required for different types of priors. Our reduction applies to myriad continuous signal space settings. This is the first peer-prediction mechanism on continuous signals designed for the multi-task setting. 2) We show how to turn a soft-predictor of an agent's signals (given the other agents' signals) into a mechanism. This allows the practical use of machine learning algorithms that give good results even when many agents provide noisy information. 3) For finite signal spaces, we obtain \$\textbackslash epsilon\$-strongly truthful mechanisms on any stochastically relevant prior, which is the maximal possible prior. In contrast, prior work only achieves a weaker notion of truthfulness (informed truthfulness) or requires stronger assumptions on the prior.},
  file = {C:\Users\Lars\Zotero\storage\ICV2SGTK\Schoenebeck and Yu - 2021 - Learning and Strongly Truthful Multi-Task Peer Prediction A Variational Approach.pdf}
}

@online{schroderLargeLanguageModels2025,
