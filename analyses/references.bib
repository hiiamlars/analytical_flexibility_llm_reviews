@article{goldbergPeerReviewsPeer2025,
  title = {Peer Reviews of Peer Reviews: {{A}} Randomized Controlled Trial and Other Experiments},
  shorttitle = {Peer Reviews of Peer Reviews},
  author = {Goldberg, Alexander and Stelmakh, Ivan and Cho, Kyunghyun and Oh, Alice and Agarwal, Alekh and Belgrave, Danielle and Shah, Nihar B},
  date = {2025-04-02},
  journaltitle = {PLOS One},
  volume = {20},
